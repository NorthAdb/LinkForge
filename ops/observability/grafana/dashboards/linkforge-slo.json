  "panels": [
    {
      "type": "row",
      "title": "Redirect (SLO demo targets, not a production promise)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100
    },
    {
      "type": "timeseries",
      "title": "Redirect QPS by status (template uri, never a code)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "linkforge-prom" },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=\"/r/{code}\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redirect latency P50 / P95 / P99 (SLO demo: P99 ≤ 100ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "linkforge-prom" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/r/{code}\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/r/{code}\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/r/{code}\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "stat",
      "title": "SLO: redirect ≤ 100ms (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "linkforge-prom" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_bucket{uri=\"/r/{code}\",le=\"0.1\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri=\"/r/{code}\"}[5m]))",
          "legendFormat": "within SLO"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.99 } ] } } }
    },
    {
      "type": "stat",
      "title": "Redirect error rate 5xx (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "linkforge-prom" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/r/{code}\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri=\"/r/{code}\"}[5m]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.001 } ] } } }
    },
    {
      "type": "timeseries",
      "title": "Skipped jumps by reason (B2) and rate-limit rejections",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 9 },
