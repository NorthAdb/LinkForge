# LOCAL/DEV EXAMPLES ONLY.
# Copy to .env before docker compose or running the app. .env is gitignored.
# These values are placeholders for a laptop. Do not reuse them anywhere else.

MYSQL_ROOT_PASSWORD=linkforge_root
MYSQL_DATABASE=linkforge
MYSQL_USER=linkforge
MYSQL_PASSWORD=linkforge_pass
MYSQL_PORT=3306

REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_USER=linkforge
RABBITMQ_PASSWORD=linkforge_pass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# App (when running outside the Compose network). Source this file or export the vars.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/linkforge?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=linkforge
SPRING_DATASOURCE_PASSWORD=linkforge_pass
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=linkforge
SPRING_RABBITMQ_PASSWORD=linkforge_pass

# HMAC key; must be at least 32 characters. Local placeholder only.
JWT_SECRET=linkforge-dev-secret-change-me-at-least-32-chars

# Bootstrap login written on startup (no public registration).
LINKFORGE_BOOTSTRAP_TENANT=demo
LINKFORGE_BOOTSTRAP_USERNAME=admin
LINKFORGE_BOOTSTRAP_PASSWORD=admin123

# Optional: open-registration per-IP rate limit (fixed window). Defaults shown.
# LINKFORGE_REGISTER_MAX=5
# LINKFORGE_REGISTER_WINDOW_SECONDS=600
# LINKFORGE_RATELIMIT_KEY_PREFIX=linkforge:rl:
