  "cards": [
    {
      "dot": "orange",
      "title": "同步/异步边界",
      "items": [
        "热路径零 MQ 依赖：recordClick 同事务只写两行，MQ 停机跳转照常 302",
        "sync/async 双开关（application.yml :177-178 生产默认双开）拼出四种部署矩阵",
        "B2 过滤在事务外：prefetch/预览 bot 拿同样 302 但不记点击",
        "eventId：sync 开 = log-{明细id} 确定性；sync 关 = UUID 存 outbox payload"
      ]
    },
    {
      "dot": "rose",
      "title": "at-least-once 与幂等",
      "items": [
        "多实例 relay 并发拉批、markSent 前崩溃，同一事件可能投两次",
        "lf_consumed_event 主键 INSERT 即锁：重复 ack 不计数，是唯一兜底",
        "UUID 事件由消费者回填 lf_click_log 并打 event_id 标记，对账不重放",
        "去重、回填、聚合、webhook 入队同一个手工短事务，崩溃回滚到未消费态"
      ]
    },
    {
      "dot": "emerald",
      "title": "两个时钟口径",
      "items": [
        "调度列（next_attempt_at / window_start）一律 DB 时钟 DATE_ADD(NOW())",
        "sent_at 用 JVM 业务时钟：outbox 清理用 DB NOW()，webhook 清理传 JVM cutoff",
        "reconcile 每 30s 反连接扫未消费明细，与 relay 双通道汇合于去重锁"
      ]
    },
    {
      "dot": "slate",
      "title": "失败出口与拓扑",
      "items": [
        "relay 退避 min(60, 2^n) 秒、30 次 FAILED 终态，手工 UPDATE 回 PENDING 重放",
        "webhook 退避 10×2^n ≤1h、上限 8 次；其他 4xx 首败即 FAILED",
        "消费失败一次 reject 不重回队列，经 DLX（click.dead）进 DLQ，人工是唯一出口",
        "拓扑：linkforge.click.exchange →(click.recorded)→ linkforge.click.queue"
      ]
    }
  ]
}