  "cards": [
    {
      "dot": "cyan",
      "title": "读侧扫描条件（relay 拉批）",
      "items": [
        "selectPendingBatch：status='PENDING' AND (next_attempt_at IS NULL OR next_attempt_at<=NOW()) ORDER BY id LIMIT 100（OutboxMapper:14-17）",
        "扫描走 idx_outbox_pending(status,next_attempt_at,id)；relay fixedDelay 2s、批 100（ClickOutboxRelay:37-45）",
        "开关每 tick 重读，演练可运行时拨动（:40-43）；外层 catch 吞整轮只记 warn（:70-72）"
      ]
    },
    {
      "dot": "amber",
      "title": "三个 mark 仅 WHERE id（与 Webhook 侧差异）",
      "items": [
        "outbox 的 markSent/markRetry/markFailed 均无 status='PENDING' 守卫（OutboxMapper:19-27）",
        "对照 WebhookDeliveryMapper:27-39：三条 mark 全带 AND status='PENDING'",
        "差异根源（推断）：outbox 拉取→发布→mark 同轮同步完成，重复 markSent 幂等无害；webhook 在途投递跨 2s tick"
      ]
    },
    {
      "dot": "rose",
      "title": "DB 时钟与重试节奏",
      "items": [
        "next_attempt_at 写 DATE_ADD(NOW())、比较 <=NOW()；sent_at=NOW()；清理 DATE_SUB(NOW(),7 天)——全 DB 时钟（OutboxMapper:14-35）",
        "markRetry：attempts DB 端 +1；退避 min(60, 2^n)：1,2,4,8,16,32 后恒 60 秒（ClickOutboxRelay:62、:75-78）",
        "attempts≥30 → markFailed + meter outbox.failed（:48-53）→ FAILED 终态",
        "多实例 at-least-once：重复投递由消费端 lf_consumed_event 主键幂等兜底（README:412）"
      ]
    }
  ]
}
