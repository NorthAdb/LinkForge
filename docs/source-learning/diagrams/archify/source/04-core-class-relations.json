  "cards": [
    {
      "dot": "rose",
      "title": "RedirectOutcome 四变体（:13-27）",
      "items": [
        "Redirect(link, url, variantKey)：302 Location，仅此分支做 B2 分类与记点击",
        "Blocked()：403 拦截页（GatePages），无 Location、不回显目标",
        "Locked(link)：GET 200 解锁页 / HEAD 401",
        "Warn(code, url, asciiHost)：200 提示页，lf_continue=1 继续"
      ]
    },
    {
      "dot": "amber",
      "title": "为控图省略的类型",
      "items": [
        "LinkVariantMapper.selectByLinkId（variants 抽签数据源）",
        "ShortLinkRowLoader（SingleFlight 的行读适配，包着 ShortLinkMapper）",
        "ClickFilter（resolveForGet 的 prefetch/bot 门禁，命中照常 302 但不记点击）",
        "WebhookDeliveryRelay → PinnedHttpSender（webhook 投递钉址链）",
        "ClickLogMapper/OutboxMapper 与 4 个 stats Mapper；其余 9 个构造器依赖（stringRedisTemplate/properties/rateLimiter/meterRegistry/transactionTemplate/passwordEncoder 等）"
      ]
    },
    {
      "dot": "cyan",
      "title": "点击管道是数据流，不是调用链",
      "items": [
        "ClickRecordService 与 ClickOutboxRelay 无类级依赖：同事务写 lf_outbox PENDING 行，relay 每 2s 定时抽水",
        "RabbitClickEventPublisher 确认（ack/可路由）后才返回，失败抛异常让 outbox 保持 PENDING 重试",
        "ClickStatsService.consume 同事务末尾 recordClickDelivery 入 Webhook 队（WebhookService 及投递链已省略）"
      ]
    },
    {
      "dot": "violet",
      "title": "CacheBus 发布/订阅解耦",
      "items": [
        "publishBloomPut / publishL1Invalidate 双频道，载荷 code|origin，发布失败吞掉打点 fail-open",
        "CodeBloomFilter 与 UrlLocalCache 经 RedisMessageListenerContainer 各自订阅，与 CacheBus 无类级依赖",
        "同一广播两种订阅策略：L1 跳过自己 origin 防自伤；Bloom 刻意不跳（put 幂等防丢）"
      ]
    }
  ]
}
