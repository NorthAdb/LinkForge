  "cards": [
    {
      "dot": "cyan",
      "title": "发布确认（A7）",
      "items": [
        "publisher-confirm-type=correlated、publisher-returns=true、template.mandatory=true 三开关全开",
        "nack、不可路由、5s 确认超时都抛异常，outbox 行保持 PENDING 由 Relay 重试",
        "Jackson2JsonMessageConverter 复用 Spring 的 ObjectMapper，否则 LocalDateTime 事件全数死信"
      ]
    },
    {
      "dot": "rose",
      "title": "死信路径",
      "items": [
        "clickQueue 参数：x-dead-letter-exchange=linkforge.click.dlx，x-dead-letter-routing-key=click.dead",
        "消费异常 reject 且不重队（default-requeue-rejected=false）→ 经 DLX 落入 click.dlq",
        "重复 eventId 直接 ack 不再计数，消费幂等靠 lf_consumed_event"
      ]
    },
    {
      "dot": "emerald",
      "title": "拓扑声明",
      "items": [
        "六个 @Bean：clickExchange / clickQueue / clickBinding / clickDlx / clickDlq / clickDlqBinding",
        "Relay 收到 broker 确认后才把 outbox 行标 SENT；FAILED 行保留，SQL 复位 PENDING 即重放"
      ]
    }
  ]
