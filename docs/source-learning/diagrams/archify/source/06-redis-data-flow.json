      "from": "l1Channel",
      "to": "l1Cache",
      "label": "跳过自己",
      "variant": "dashed"
    },
    {
      "id": "rowread-mark",
      "from": "rowRead",
      "to": "absentOps",
      "label": "行 null",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
