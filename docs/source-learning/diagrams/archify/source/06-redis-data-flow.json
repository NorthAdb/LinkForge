      "id": "absent-set",
      "from": "absentOps",
      "to": "absentKey",
      "label": "SET 1",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "absent-gate",
      "from": "absentKey",
      "to": "absentGate",
      "label": "哨兵 404",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "entries-acquire",
      "from": "entries",
      "to": "limiter",
      "label": "acquire",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "limiter-zadd",
      "from": "limiter",
      "to": "swKey",
      "label": "ZADD",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "idem-acquire",
      "from": "idemCreate",
      "to": "idemOps",
      "label": "SETNX 抢占",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "idem-settle",
      "from": "idemOps",
      "to": "idemKey",
      "label": "落定",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "idem-replay",
      "from": "idemKey",
      "to": "replay",
      "label": "重放",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    }
  ],
  "cards": [
    {
      "dot": "orange",
      "title": "写路径三件套",
      "items": [
        "update 写穿新 URL，disable/delete 只删不写（evictCache :979-989）",
        "1 秒延迟双删清并发读者的迟到回填（scheduleStaleClear :991-999）",
        "广播只在写路径本尊发一次，延迟遍绝不补发（:517-518）",
        "cacheUrl 三处调用：创建预热 :269、update 写穿 :515、跳转 L2 miss 回填 :679"
      ]
    },
    {
      "dot": "emerald",
      "title": "TTL 与时钟",
      "items": [
        "正缓存 3600+uniform[0,300]s 只向上抖动防雪崩（jitteredTtlSeconds :918-924）",
        "空值 60+30s，禁用/过期绝不写入；创建尾段 clearAbsent DEL 清哨兵（:268）",
        "幂等 pending 5s、落定 24h，单键无抖动；限流窗口 PEXPIRE 保活，Lua 取 Redis TIME",
        "API Key 分钟窗 60s；日窗 {rl}apikey:day:{keyId}:{yyyyMMdd} 固定键 INCR，86400s"
      ]
    },
    {
      "dot": "rose",
      "title": "广播语义与 fail-open",
      "items": [
        "双频道 at-most-once：丢失靠 TTL 兜底（L1 10s、L2 3600s），不靠重放",
        "同一广播两种订阅：L1 跳过自己 origin 防自伤，Bloom 不跳（put 幂等防丢）",
        "L2 读写删、absent 探测、幂等读取全部 fail-open，跳转绝不 500",
        "行读永远发生：Redis 只省 URL 字段，不替 DB 挡流量"
      ]
    }
  ]
}