  "cards": [
    {
      "dot": "cyan",
      "title": "同步路径",
      "items": [
        "管理 API 与跳转链路同步读写 MySQL / Redis",
        "302 后同事务写 lf_click_log + lf_outbox",
        "统计查询读 MySQL 聚合表，UV 按 IP 去重"
      ]
    },
    {
      "dot": "emerald",
      "title": "异步管道",
      "items": [
        "Outbox Relay 每 2s 轮询 PENDING，confirm 后标 SENT",
        "AMQP 经 linkforge.click.exchange，消费端 eventId 幂等",
        "Webhook 投递行独立 Relay 轮询，HMAC 签名推送"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与守卫",
      "items": [
        "入口统一过安全过滤器（JWT / API Key / 抓取令牌）",
        "可观测端点令牌未配置即 fail-closed 401",
        "点击记账失败 fail-open，302 不受影响"
      ]
    }
  ]
