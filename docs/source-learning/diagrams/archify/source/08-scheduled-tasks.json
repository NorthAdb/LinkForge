  "cards": [
    {
      "dot": "cyan",
      "title": "共享调度池与隔离",
      "items": [
        "全部 @Scheduled 任务共享一个调度池，size=6（spring.task.scheduling.pool，application.yml）",
        "池的隔离意图：webhook 端点再慢，也不得拖住 outbox 追平与对账（B5）",
        "各任务固定 delay 自旋，批次、退避、上限全部走配置项"
      ]
    },
    {
      "dot": "rose",
      "title": "重试与终态",
      "items": [
        "outbox：退避 2ⁿ≤60s，超 30 次标 FAILED（保留，SQL 复位 PENDING 即重放）",
        "webhook：退避 10·2ⁿ≤1h，8 次后 FAILED；2xx 即 SENT；at-least-once 由接收方按 eventId 去重",
        "SENT 行保留 7 天，cleanup 每遍删 1000 行、最多 10 遍；PENDING/FAILED 永不删"
      ]
    },
    {
      "dot": "emerald",
      "title": "读侧设施",
      "items": [
        "Bloom 重建 bypass-then-swap：先发布新过滤器再回填全量 code，失败回滚旧引用",
        "Phishing 名单按 mtime 热载，坏文件保留旧快照（fail-safe）",
        "积压仪表 15s 采样三条 COUNT，抓取路径不碰 DB"
      ]
    }
  ]
}